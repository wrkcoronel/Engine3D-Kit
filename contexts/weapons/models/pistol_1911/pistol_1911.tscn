[node name="CartuchoCamara" parent="Visual" instance=ExtResource("Cartucho_45")]
editor_description = "Cartucho .45 no eixo do cano. Na conferencia, o extrator acompanha o culote para tras, mostrando o latao na abertura curta, sem ejetar nem consumir municao. A transformacao inicial e guardada como repouso pelo modulo de conferencia."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.018, -0.0265)
visible = false

[node name="ConferenciaCamara" type="Marker3D" parent="."]
transform = Transform3D(0.67291, 0.17241, 0.71935, -0.48389, 0.83813, 0.25177, -0.55950, -0.51751, 0.64742, 0.0148, 0.018, -0.012)
editor_description = "Conferencia da camara (R segurado com a arma cheia ou sem reserva): primeiro a pistola vira na diagonal, depois o ferrolho recua o curso inteiro (35 mm), como na trava aberta. Ao soltar R, o ferrolho fecha antes de a arma voltar. As maos levam este ponto ate metadata/alvo (espaco da camera) e o +Z dele se vira para o olho."
metadata/alvo = Vector3(0.03, -0.06, -0.24)
metadata/recuo_ferrolho = 0.035

