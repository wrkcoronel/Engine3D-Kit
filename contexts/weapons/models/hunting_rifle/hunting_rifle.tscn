[node name="Conferencia" type="Marker3D" parent="."]
transform = Transform3D(0.67291, 0.17241, 0.71935, -0.48389, 0.83813, 0.25177, -0.55950, -0.51751, 0.64742, 0.017, 0.004, -0.11)
editor_description = "Conferencia de municao, com a arma jogada de lado na diagonal (lado direito para o olho): no C o ferrolho abre todo e mostra o carregador; no R com a arma cheia ele recua so metadata/recuo_camara (fracao do curso). Os dois mostram os cartuchos que estao na arma: os tres de cima a vista, o resto escondido no carregador. As maos levam este ponto ate metadata/alvo e o +Z dele se vira para o olho."
metadata/recuo_camara = 0.4
metadata/puxar_carregador = Vector3(0, 0, 0)
metadata/alvo = Vector3(0.05, -0.09, -0.32)
