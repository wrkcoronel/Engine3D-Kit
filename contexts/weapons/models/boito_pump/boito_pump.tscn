[node name="Conferencia" type="Marker3D" parent="."]
transform = Transform3D(-0.70155, -0.59522, 0.39184, 0.11504, -0.63724, -0.76203, 0.70327, -0.48953, 0.51553, 0, -0.03, -0.11)
editor_description = "Conferencia de municao, na janela de carga: a arma vira de barriga para cima e vem na diagonal, com a mao direita no punho da coronha (embaixo, a direita, perto do peito) e a esquerda na telha (a frente, a esquerda). As maos levam este ponto ate metadata/alvo (espaco da camera) e o +Z dele se vira para o olho do jogador."
metadata/puxar_carregador = Vector3(0, 0, 0)
metadata/alvo = Vector3(0.0173, -0.1564, -0.36)

[node name="Interior" type="MeshInstance3D" parent="Visual/Corpo"]
editor_description = "Interior escuro do receptor (faces para dentro), visto pela janela de ejecao. Fica todo dentro do receptor (x +-0,0195, y -0,025 a 0,0185): maior, as quinas atravessavam os chanfros e apareciam por fora como laminas e triangulos pretos."
